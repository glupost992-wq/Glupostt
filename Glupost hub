local function updateBoxPosition(d, parts, rd)
    if rd.distance > Config.ESP.MaxDistance or rd.distance < Config.ESP.MinDistance or not rd.onScreen then
        if d.drawings then
            if d.drawings.lines then
                for _,l in pairs(d.drawings.lines) do
                    l.Visible = false
                end
            end
            if d.drawings.corners then
                for _,c in pairs(d.drawings.corners) do
                    c.Visible = false
                end
            end
        end
        return false
    end

    local head = parts.Head
    local hrp = parts.HumanoidRootPart
    if not head or not hrp or not isPartValid(hrp) or not isPartValid(head) then
        return false
    end

    local headPos3D, headOnScreen = Camera:WorldToScreenPoint(head.Position + Vector3.new(0, 0.5, 0))
    local legPos3D, legOnScreen = Camera:WorldToScreenPoint(hrp.Position - Vector3.new(0, 3, 0))

    local headPos = Vector2.new(headPos3D.X, headPos3D.Y)
    local legPos = Vector2.new(legPos3D.X, legPos3D.Y)

    local height = math.abs(headPos.Y - legPos.Y)
    if height < 2 then return false end

    local width = height * 0.8
    local left = rd.hrpPos.X - width / 2
    local top = headPos.Y
    local right = left + width
    local bottom = top + height
    local color = getBoxColor(parts._player, rd.visible, rd.priority)

    if Config.ESP.BoxType == "2D" then
        if not d.drawings then d.drawings = {} end
        local lines = d.drawings.lines
        if not lines then
            lines = {}
            for i = 1, 4 do
                lines[i] = getFromPool(drawingPool.lines, "Line")
            end
            d.drawings.lines = lines
        end

        lines[1].From = Vector2.new(left, top)
        lines[1].To = Vector2.new(right, top)
        lines[2].From = Vector2.new(right, top)
        lines[2].To = Vector2.new(right, bottom)
        lines[3].From = Vector2.new(right, bottom)
        lines[3].To = Vector2.new(left, bottom)
        lines[4].From = Vector2.new(left, bottom)
        lines[4].To = Vector2.new(left, top)

        for i = 1, 4 do
            lines[i].Color = color
            lines[i].Thickness = rd.priority and Config.ESP.BoxThickness + 2 or Config.ESP.BoxThickness
            lines[i].Visible = true
        end
        if d.drawings.corners then
            for _,c in pairs(d.drawings.corners) do
                c.Visible = false
            end
        end
    elseif Config.ESP.BoxType == "Corner" then
        if not d.drawings then d.drawings = {} end
        local corners = d.drawings.corners
        if not corners then
            corners = {}
            for i = 1, 8 do
                corners[i] = getFromPool(drawingPool.corners, "Line")
            end
            d.drawings.corners = corners
        end
        local len = 12
