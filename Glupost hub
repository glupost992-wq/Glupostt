        cachePlayerParts(plr, plr.Character)
        parts = playersData[plr].parts
        if not parts then return end
    end
    local function getPos(part)
        if part and isPartValid(part) then
            local pos3D, onScreen = Camera:WorldToScreenPoint(part.Position)
            if onScreen then
                return Vector2.new(pos3D.X, pos3D.Y)
