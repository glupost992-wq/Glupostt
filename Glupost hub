local function updateArrowOptimized(d, rd)
    if not Config.ESP.OffscreenArrows then
        if d.arrow then
            for _, a in pairs(d.arrow) do
                a.Visible = false
            end
        end
        return
    end
    if rd.onScreen then
        if d.arrow then
            for _, a in pairs(d.arrow) do
                a.Visible = false
            end
        end
        return
    end
    local hrp = rd.parts and rd.parts.HumanoidRootPart
    if not hrp or not isPartValid(hrp) then
        return
    end
    local camCF = cachedCameraCFrame
    local dir3 = (hrp.Position - camCF.Position).Unit
    local dir2 = Vector2.new(camCF.RightVector:Dot(dir3), -camCF.UpVector:Dot(dir3))
    if dir2.Magnitude < 0.001 then return end
    local dir = dir2.Unit
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local radius = math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.4
    local arrowPos = center + dir * radius
    arrowPos = Vector2.new(
        math.clamp(arrowPos.X, Config.ESP.ArrowSize, Camera.ViewportSize.X - Config.ESP.ArrowSize),
        math.clamp(arrowPos.Y, Config.ESP.ArrowSize, Camera.ViewportSize.Y - Config.ESP.ArrowSize)
    )
    if not d.arrow then
        d.arrow = {
            getFromPool(drawingPool.arrows, "Line"),
            getFromPool(drawingPool.arrows, "Line"),
            getFromPool(drawingPool.arrows, "Line")
        }
        for _, a in pairs(d.arrow) do
            a.Thickness = 2
        end
    end
    local len = Config.ESP.ArrowSize
    local tip = arrowPos + dir * len
    local perp = Vector2.new(-dir.Y, dir.X) * (len * 0.4)
    local color = rd.priority and Config.ESP.PriorityColor or Config.ESP.ArrowColor
    d.arrow[1].From = tip
    d.arrow[1].To = arrowPos - dir * len
    d.arrow[2].From = tip
    d.arrow[2].To = arrowPos + perp - dir * (len * 0.5)
    d.arrow[3].From = tip
    d.arrow[3].To = arrowPos - perp - dir * (len * 0.5)
    for _, a in pairs(d.arrow) do
        a.Color = color
        a.Visible = true
    end
end

-- ===== THREAT SCORE & PREDICTION =====
local function isVisibleThreat(head)
    if not head then return false end
    local origin = cachedCameraPosition
    local dir = head.Position - origin
    local rayParamsLocal = RaycastParams.new()
    rayParamsLocal.FilterType = Enum.RaycastFilterType.Exclude
    rayParamsLocal.FilterDescendantsInstances = { LP.Character }
    local result = workspace:Raycast(origin, dir, rayParamsLocal)
    if not result then return true end
    return result.Instance:IsDescendantOf(head.Parent)
end

local function calculateThreatScore(plr, parts)
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or cachedCameraPosition

    local targetHead = parts.Head
    if not targetHead then return -1000 end
    local targetRoot = parts.HumanoidRootPart
    local targetHum = parts.humanoid
    if not targetRoot or not targetHum or targetHum.Health <= 0 then
        return -1000
    end

    local dist = (myPos - targetRoot.Position).Magnitude

    local visible = isVisibleThreat(targetHead)
    local visNorm = visible and 1 or 0

    local lookNorm = 0
    if targetHead and myRoot then
        local lookVector = targetHead.CFrame.LookVector
        local toMe = (myRoot.Position - targetHead.Position).Unit
        local dot = lookVector:Dot(toMe)
        lookNorm = (dot + 1) / 2
    end

    local maxDist = Config.ESP.MaxDistance
    local distNorm = 1 - math.clamp(dist / maxDist, 0, 1)

    local health = targetHum.Health
    local maxHealth = targetHum.MaxHealth
    if maxHealth <= 0 then maxHealth = 100 end
    local healthNorm = 1 - health / maxHealth

    local weights = Config.ThreatWeights
    local score = visNorm * weights.Visibility +
                  lookNorm * weights.LookAtMe +
                  distNorm * weights.Distance +
                  healthNorm * weights.Health
    threatScoreCache[plr] = score
    return score
end

local function updatePredictionCache()
    local now = os.clock()
    if now - lastPredictionUpdate < CONST.PREDICTION_CACHE_INTERVAL then
        return
    end
    lastPredictionUpdate = now
    for plr, data in pairs(playersData) do
        local parts = data.parts
        if not parts or not parts.HumanoidRootPart then
            goto continue
        end
        local hrp = parts.HumanoidRootPart
        if not isPartValid(hrp) then
            goto continue
        end
        local pos = hrp.Position
        local prev = predictionCache[plr]
        if prev then
            local dt = now - prev.time
            if dt > CONST.PREDICTION_MIN_DT then
                local newVel = (pos - prev.pos) / dt
                local newAcc = (newVel - prev.velocity) / dt
                prev.acceleration = prev.acceleration * 0.5 + newAcc * 0.5
                prev.velocity = prev.velocity * Config.Aimbot.VelocitySmoothing + newVel * (1 - Config.Aimbot.VelocitySmoothing)
            end
            prev.pos = pos
            prev.time = now
        else
            predictionCache[plr] = {
                pos = pos,
                velocity = Vector3.zero,
                acceleration = Vector3.zero,
                time = now
            }
        end
        ::continue::
    end
end

local function getPredictedPosition(targetPart)
    if not Config.Aimbot.Prediction then
        return targetPart.Position
    end
    local plr = Players:GetPlayerFromCharacter(targetPart.Parent)
    if not plr then
        return targetPart.Position
    end
    local pred = predictionCache[plr]
    if not pred then
        return targetPart.Position
    end
    local dt = os.clock() - pred.time
    if dt > 0.2 then
        return targetPart.Position
    end
    local t = Config.Aimbot.PredictionFactor
    local base = pred.velocity * t + 0.5 * pred.acceleration * t * t
    local gravity = CONST.DEFAULT_GRAVITY * (Config.Aimbot.GravityFactor or 1.0)
    base = base - Vector3.new(0, 0.5 * gravity * t * t, 0)
    return targetPart.Position + base
end

-- ===== SILENT AIM =====
local oldNamecall, oldIndex
local ourSilentHook = {}

local function getRandomBone(character)
    if not character then return nil end
    if not Config.Aimbot.RandomBone then return nil end
    local weights = Config.Aimbot.BoneWeights
    local plr = Players:GetPlayerFromCharacter(character)
    if not plr or not playersData[plr] then return nil end
    local parts = playersData[plr].parts
    local candidates = {}
    local totalWeight = 0
    for boneName, weight in pairs(weights) do
        local part = parts[boneName]
        if part and isPartValid(part) then
            table.insert(candidates, {part = part, weight = weight})
            totalWeight = totalWeight + weight
        end
    end
    if #candidates == 0 then return nil end
    local r = math.random() * totalWeight
    local sum = 0
    for _, candidate in ipairs(candidates) do
        sum = sum + candidate.weight
        if r <= sum then
            return candidate.part
        end
    end
    return candidates[#candidates].part
end

local function initSilentAimbot()
    if silentHooksActive then return end
    
    local namecallHook = function(self, ...)
        local args = {...}
        local success, isEngineCall = pcall(function()
            return checkcaller()
        end)
        if success and isEngineCall then
            return oldNamecall(self, ...)
        end

        local method = getnamecallmethod()
        if Config.Aimbot.SilentEnabled and Config.Aimbot.Enabled and not isUnloaded then
            if (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and self == workspace then
                if currentTarget and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    local targetPos = currentTarget.Position
                    local lookVector = cachedCameraCFrame.LookVector
                    local dirToTarget = (targetPos - cachedCameraCFrame.Position).Unit
                    local angle = math.acos(math.clamp(lookVector:Dot(dirToTarget), -1, 1))
                    if math.deg(angle) > Config.Aimbot.SilentMaxAngle then
                        return oldNamecall(self, ...)
                    end

                    if math.random(1,100) <= Config.Aimbot.HitChance then
                        local ray = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                        local effectiveTarget = currentTarget
                        if Config.Aimbot.RandomBone then
                            local randomPart = getRandomBone(effectiveTarget.Parent)
                            if randomPart then
                                effectiveTarget = randomPart
                            end
                        end
                        
                        local jitter
                        if RageActive and RageConfig.RageFeatures.MultiPoint then
                            jitter = Vector3.new(
                                (math.random() - 0.5) * 2 * RageConfig.RageFeatures.MultiPointSpread,
                                (math.random() - 0.5) * 2 * RageConfig.RageFeatures.MultiPointSpread,
                                (math.random() - 0.5) * 2 * RageConfig.RageFeatures.MultiPointSpread
                            )
                        else
                            jitter = jitterOffset()
                        end
                        
                        local adjTarget = effectiveTarget.Position + jitter
                        if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
                            adjTarget = applyAdaptiveRCS(adjTarget)
                        end
                        local direction = (adjTarget - ray.Origin).Unit * CONST.SILENT_RAY_LENGTH

                        if method == "Raycast" and typeof(ray.Origin) == "Vector3" then
                            return oldNamecall(self, ray.Origin, direction, unpack(args, 3))
                        elseif method ~= "Raycast" then
                            local oldRay = args[1]
                            if oldRay then
                                args[1] = Ray.new(oldRay.Origin, (adjTarget - oldRay.Origin).Unit * CONST.SILENT_RAY_LENGTH)
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end

    local indexHook = function(self, key)
        if Config.Aimbot.SilentEnabled and Config.Aimbot.Enabled and not isUnloaded and not UIS:GetFocusedTextBox() then
            if typeof(self) == "Instance" and self:IsA("Mouse") then
                if (key == "Hit" or key == "Target") and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    if currentTarget and math.random(1,100) <= Config.Aimbot.HitChance then
                        local adjTarget = currentTarget.Position
                        if Config.Aimbot.RandomBone then
                            local randomPart = getRandomBone(currentTarget.Parent)
                            if randomPart then
                                adjTarget = randomPart.Position
                            end
                        end
                        if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
                            adjTarget = applyAdaptiveRCS(adjTarget)
                        end
                        if key == "Hit" then
                            return CFrame.new(adjTarget)
                        else
                            return currentTarget
                        end
                    end
                end
            end
        end
        return oldIndex(self, key)
    end

    if hookmetamethod then
        oldNamecall = hookmetamethod(game, "__namecall", namecallHook)
        oldIndex = hookmetamethod(game, "__index", indexHook)
    else
        local gmt = getrawmetatable(game)
        if gmt then
            oldNamecall = gmt.__namecall
            oldIndex = gmt.__index
            setreadonly(gmt, false)
            gmt.__namecall = namecallHook
            gmt.__index = indexHook
            setreadonly(gmt, true)
        end
    end
    ourSilentHook = { namecall = namecallHook, index = indexHook }
    silentHooksActive = true
end

local function removeSilentHook()
    if not ourSilentHook.namecall then return end
    if hookmetamethod then
        pcall(function()
            hookmetamethod(game, "__namecall", oldNamecall)
        end)
        pcall(function()
            hookmetamethod(game, "__index", oldIndex)
        end)
    else
        local gmt = getrawmetatable(game)
        if gmt then
            setreadonly(gmt, false)
            if gmt.__namecall == ourSilentHook.namecall then
                gmt.__namecall = oldNamecall
            end
            if gmt.__index == ourSilentHook.index then
                gmt.__index = oldIndex
            end
            setreadonly(gmt, true)
        end
    end
    ourSilentHook = {}
    silentHooksActive = false
end

local function recoverHooks()
    if not silentHooksActive then
        initSilentAimbot()
    end
end

-- ===== СГЛАЖИВАНИЕ =====
local function applySmoothing(currentCF, targetCF, targetPart, dt)
    local smoothType = Config.Aimbot.SmoothnessType
    
    if not Config.Aimbot.Humanize and smoothType == "HumanLike" then
        smoothType = "Linear"
    end
    
    if smoothType == "Instant" then
        return targetCF
    end

    local angle = math.acos(math.clamp(currentCF.LookVector:Dot(targetCF.LookVector), -1, 1))
    if angle > math.rad(CONST.ANGLE_SAFETY_DEG) then
        return currentCF
    end

    local t = Config.Aimbot.Smoothness
    local fpsFactor = math.clamp(dt * 60, 0.1, 2.0)

    if smoothType == "Linear" then
        return currentCF:Lerp(targetCF, math.clamp(t * fpsFactor, 0.01, 0.99))
    elseif smoothType == "Easing" then
        local eased = 1 - math.pow(1 - (t * fpsFactor), 3)
        return currentCF:Lerp(targetCF, math.clamp(eased, 0.01, 0.99))
    elseif smoothType == "HumanLike" then
        local factor = getHumanizedFactor(dt)
        return currentCF:Lerp(targetCF, math.clamp(factor, 0.05, 0.8))
    end
    return targetCF
end

-- ===== DYNAMIC FOV =====
local function getDynamicFOVRadius()
    local baseRadius = Config.Aimbot.FOVRadius
    if not Config.Aimbot.DynamicFOV then
        return baseRadius
    end
    local mouseDelta = UIS:GetMouseDelta()
    local mouseSpeed = mouseDelta.Magnitude
    local char = LP.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local moveSpeed = humanoid and humanoid.MoveDirection.Magnitude or 0
    local factor = math.sqrt(
        mouseSpeed * CONST.DYNAMIC_FOV_MOUSE_FACTOR +
        moveSpeed * CONST.DYNAMIC_FOV_MOVE_FACTOR
    )
    return baseRadius + math.clamp(factor * 15, 0, CONST.DYNAMIC_FOV_MAX_INCREASE)
end

local function updateFOV()
    if not Config.Aimbot.ShowFOV then
        fovDraw.Visible = false
        squareFOV.Visible = false
        return
    end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local radius = getDynamicFOVRadius()
    local color = Config.Aimbot.FOVColor
    local thickness = Config.Aimbot.FOVThickness
    if Config.Aimbot.FOVShape == "Circle" then
        fovDraw.Position = center
        fovDraw.Radius = radius
        fovDraw.Color = color
        fovDraw.Thickness = thickness
        fovDraw.Filled = Config.Aimbot.FilledFOV
        fovDraw.Transparency = Config.Aimbot.FOVTransparency
        fovDraw.Visible = true
        squareFOV.Visible = false
    else
        local left = center.X - radius
        local top = center.Y - radius
        local right = center.X + radius
        local bottom = center.Y + radius
        squareFOV.PointA = Vector2.new(left, top)
        squareFOV.PointB = Vector2.new(right, top)
        squareFOV.PointC = Vector2.new(right, bottom)
        squareFOV.PointD = Vector2.new(left, bottom)
        squareFOV.Color = color
        squareFOV.Thickness = thickness
        squareFOV.Filled = false
        squareFOV.Transparency = Config.Aimbot.FOVTransparency
        squareFOV.Visible = true
        fovDraw.Visible = false
    end
end

-- ===== GET BEST TARGET =====
local function getBestTarget()
    local bestTarget = nil
    local bestScore = -math.huge
    local maxDist = Config.ESP.MaxDistance
    local fovRadius = getDynamicFOVRadius()
    local wallCheck = Config.Aimbot.WallCheck

    for plr, data in pairs(playersData) do
        if not data.parts then
            goto continue
        end
        local parts = data.parts
        if Config.Aimbot.TeamCheck and isTeammate(plr) then
            goto continue
        end
        if Config.ESP.HideTeammates and isTeammate(plr) then
            goto continue
        end
        local targetPart = parts[Config.Aimbot.TargetPart]
        if not targetPart or not isPartValid(targetPart) then
            goto continue
        end
        local hum = parts.humanoid
        if not hum or hum.Health <= 0 then
            goto continue
        end
        local predictedPos = getPredictedPosition(targetPart)
        local distanceStuds = (cachedCameraCFrame.Position - predictedPos).Magnitude
        if distanceStuds > maxDist then
            goto continue
        end
        local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
        if not onScreen then
            goto continue
        end
        local distPixels = (Vector2.new(screenPos.X, screenPos.Y) -
                           Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if distPixels > fovRadius then
            goto continue
        end
        if wallCheck then
            if not parts.Character then
                goto continue
            end
            local origin = cachedCameraCFrame.Position
            local dir = predictedPos - origin
            aimRayParams.FilterDescendantsInstances = { Camera, LP.Character, parts.Character }
            if workspace:Raycast(origin, dir, aimRayParams) then
                goto continue
            end
        end
        local score = 0
        if Config.Aimbot.PriorityMode == "Threat" then
            score = calculateThreatScore(plr, parts)
        elseif Config.Aimbot.PriorityMode == "Distance" then
            score = -distanceStuds
        elseif Config.Aimbot.PriorityMode == "Crosshair" then
            score = -distPixels
        elseif Config.Aimbot.PriorityMode == "Health" then
            score = -hum.Health
        elseif Config.Aimbot.PriorityMode == "Visible" then
            local visible = isVisibleCached(data, parts.Head)
            score = (visible and 500 or 0) - distanceStuds * 0.5
        end
        if score > bestScore then
            bestScore = score
            bestTarget = targetPart
        end
        ::continue::
    end
    return bestTarget
end

-- ===== KILL AURA =====
local function updateKillAuraCache()
    if not RageActive or not RageConfig.RageFeatures.Enabled or not RageConfig.RageMasterSwitch then
        killAuraTargetsCache = {}
        return
    end
    local now = os.clock()
    if now - killAuraLastUpdate < CONST.KILL_AURA_CYCLE_DELAY then
        return
    end
    killAuraLastUpdate = now
    killAuraTargetsCache = {}
    local char = LP.Character
    if not char then
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not isPartValid(hrp) then
        return
    end
    local myPos = hrp.Position
    local radius = RageConfig.RageFeatures.KillAuraRadius

    for plr, data in pairs(playersData) do
        if plr == LP then
            goto continue
        end
        local parts = data.parts
        if not parts then
            goto continue
        end
        local targetPart = parts[Config.Aimbot.TargetPart]
        if not targetPart or not isPartValid(targetPart) then
            goto continue
        end
        local hum = parts.humanoid
        if not hum or hum.Health <= 0 then
            goto continue
        end
        local dist = (myPos - targetPart.Position).Magnitude
        if dist <= radius then
            if Config.Aimbot.TeamCheck and isTeammate(plr) then
                goto continue
            end
            local doWallCheck = Config.Aimbot.WallCheck and not RageConfig.RageFeatures.AutoWall
            if doWallCheck then
                if not parts.Character then
                    goto continue
                end
                local origin = cachedCameraCFrame.Position
                local dir = targetPart.Position - origin
                aimRayParams.FilterDescendantsInstances = { Camera, LP.Character, parts.Character }
                if workspace:Raycast(origin, dir, aimRayParams) then
                    goto continue
                end
            end
            table.insert(killAuraTargetsCache, targetPart)
        end
        ::continue::
    end
    killAuraIndex = 1
end

local function getKillAuraTarget()
    if #killAuraTargetsCache == 0 then
        return nil
    end
    if not killAuraIndex or killAuraIndex > #killAuraTargetsCache then
        killAuraIndex = 1
    end
    local target = killAuraTargetsCache[killAuraIndex]
    killAuraIndex = killAuraIndex + 1
    return target
end

-- ===== ГЛАВНЫЙ ЦИКЛ =====
local aimActive = false
local aimKeyPressedTime = 0
local lastAutoFireShot = 0

local function startAutoFireLoop()
    if autoFireLock then return end
    autoFireLock = true
    if autoFireThread then
        task.cancel(autoFireThread)
    end
    autoFireThread = task.spawn(function()
        while not isUnloaded and RageActive and RageConfig.RageFeatures.Enabled and RageConfig.RageMasterSwitch and
              (RageConfig.RageFeatures.AutoFire or RageConfig.RageFeatures.RapidFire) do
            if currentTarget then
                local minCd, maxCd
                if RageConfig.RageFeatures.RapidFire then
                    minCd = CONST.RAPID_FIRE_MIN_COOLDOWN
                    maxCd = CONST.RAPID_FIRE_MAX_COOLDOWN
                else
                    minCd = CONST.AUTO_FIRE_MIN_COOLDOWN
                    maxCd = CONST.AUTO_FIRE_MAX_COOLDOWN
                end
                local cooldown = getRandomDelay(minCd, maxCd)
                local now = os.clock()
                if now - lastAutoFireShot >= cooldown then
                    if math.random(1,100) <= Config.Aimbot.HitChance then
                        if mouse1press and mouse1release then
                            mouse1press()
                            local waitTime = getRandomDelay(0.005, 0.02)
                            task.wait(waitTime)
                            mouse1release()
                            if RageConfig.RageFeatures.DoubleTap then
                                task.wait(RageConfig.RageFeatures.DTDelay)
                                mouse1press()
                                task.wait(waitTime)
                                mouse1release()
                            end
                        end
                    end
                    lastAutoFireShot = now
                    recordRecoilStart()
                end
            end
            task.wait(0.001)
        end
        autoFireThread = nil
        autoFireLock = false
    end)
end

local function stopAutoFireLoop()
    if autoFireThread then
        task.cancel(autoFireThread)
        autoFireThread = nil
    end
    autoFireLock = false
end

-- ОПРЕДЕЛЕНИЕ updateAntiAim (объявлено заранее)
local updateAntiAim = nil

local function updateAimbotLoop(dt)
    if isUnloaded then
        return
    end
    if not Config.Aimbot.Enabled then
        return
    end

    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then
        aimActive = false
        currentTarget = nil
        lockedTarget = nil
        if currentRecoilPattern then
            currentRecoilPattern = nil
        end
        return
    end

    if currentRecoilPattern then
        recordRecoilUpdate()
    end
    if RageActive and updateAntiAim then
        updateAntiAim(dt)
    end

    local rageActiveNow = RageActive and RageConfig.RageFeatures.Enabled and RageConfig.RageMasterSwitch

    if rageActiveNow and RageConfig.RageFeatures.TeleportKill and myHrp then
        if UIS:IsKeyDown(RageConfig.RageFeatures.TeleportKey) and currentTarget then
            local targetPos = currentTarget.Position
            myHrp.CFrame = CFrame.new(targetPos + (myHrp.CFrame.LookVector * -5))
        end
    end

    local pressed = false
    if rageActiveNow and RageConfig.RageFeatures.Triggerbot then
        pressed = true
    else
        local key = Config.Aimbot.AimbotKey
        if key.EnumType == Enum.UserInputType then
            pressed = UIS:IsMouseButtonPressed(key)
        elseif key.EnumType == Enum.KeyCode then
            pressed = UIS:IsKeyDown(key)
        end
    end

    if pressed and myHrp then
        if not aimActive then
            if aimKeyPressedTime == 0 then
                aimKeyPressedTime = os.clock()
            end
            if os.clock() - aimKeyPressedTime >= Config.Aimbot.ReactionTime then
                aimActive = true
            end
        end
    else
        aimActive = false
        aimKeyPressedTime = 0
    end

    local newTarget = nil
    if (aimActive or (rageActiveNow and RageConfig.RageFeatures.AutoFire) or
        (rageActiveNow and RageConfig.RageFeatures.KillAura)) and myHrp then
        if rageActiveNow and RageConfig.RageFeatures.KillAura then
            newTarget = getKillAuraTarget()
        elseif aimActive then
            newTarget = getBestTarget()
        end
    end

    if newTarget then
        targetLoseTimer = 0
        if not RageActive and Config.Aimbot.TargetSwitchDelay > 0 and lockedTarget then
            if newTarget ~= lockedTarget then
                if os.clock() - lastTargetSwitch < Config.Aimbot.TargetSwitchDelay then
                    newTarget = lockedTarget
                else
                    lockedTarget = newTarget
                    lastTargetSwitch = os.clock()
                end
            end
        else
            lockedTarget = newTarget
            if newTarget then
                lastTargetSwitch = os.clock()
            end
        end
    else
        targetLoseTimer = targetLoseTimer + dt
        if targetLoseTimer > CONST.TARGET_LOSE_TIMEOUT then
            lockedTarget = nil
            currentTarget = nil
        end
    end
    currentTarget = lockedTarget

    if rageActiveNow and (RageConfig.RageFeatures.AutoFire or RageConfig.RageFeatures.RapidFire) then
        if not autoFireThread and not autoFireLock then
            startAutoFireLoop()
        end
    else
        stopAutoFireLoop()
    end

    if Config.Aimbot.CameraEnabled and aimActive and currentTarget and myHrp then
        local predictedPos = getPredictedPosition(currentTarget)
        local targetPos = predictedPos
        if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
            targetPos = applyAdaptiveRCS(targetPos)
        end
        local targetCF = CFrame.new(cachedCameraCFrame.Position, targetPos)
        Camera.CFrame = applySmoothing(cachedCameraCFrame, targetCF, currentTarget, dt)
    end
end

-- ===== ESP UPDATE =====
local function updateESP()
    if isUnloaded or not Config.ESP.Enabled then
        for _,d in pairs(playersData) do
            hideAll(d)
        end
        return
    end
    
    if Config.Aimbot.UseDeferESP then
        task.spawn(function()
            if updateESPSync then
                updateESPSync()
            end
        end)
        return
    end
    
    if updateESPSync then
        updateESPSync()
    end
end

updateESPSync = function()
    local now = os.clock()
    local full = now - lastFullUpdate >= CONST.FULL_UPDATE_INTERVAL
    local skeleton = now - lastSkeletonUpdate >= CONST.SKELETON_INTERVAL
    local text = now - lastTextUpdate >= CONST.TEXT_INTERVAL
    local arrow = now - lastArrowUpdate >= CONST.ARROW_INTERVAL

    if full then
        lastFullUpdate = now
        for plr, d in pairs(playersData) do
            local parts = d.parts
            local hrp = parts and parts.HumanoidRootPart
            local head = parts and parts.Head
            local hum = parts and parts.humanoid
            if not (hrp and head and hum and hum.Health > 0 and parts.Character and parts.Character.Parent and isPartValid(hrp)) then
                hideAll(d)
                renderData[plr] = nil
                goto continue
            end
            if Config.ESP.HideTeammates and isTeammate(plr) then
                hideAll(d)
                renderData[plr] = nil
                goto continue
            end
            local screenPos3D, onScreen = Camera:WorldToScreenPoint(hrp.Position)
            local hrpPos = Vector2.new(screenPos3D.X, screenPos3D.Y)
            if not onScreen then
                hideAll(d)
                renderData[plr] = nil
                goto continue
            end
            local dist = (cachedCameraCFrame.Position - hrp.Position).Magnitude
            if dist > Config.ESP.MaxDistance or dist < Config.ESP.MinDistance then
                hideAll(d)
                renderData[plr] = nil
                goto continue
            end
            local visible = false
            if Config.ESP.VisibleCheck then
                visible = isVisibleCached(d, head)
            end
            local rd = renderData[plr] or {}
            rd.onScreen = onScreen
            rd.hrpPos = hrpPos
            rd.distance = dist
            rd.visible = visible
            rd.parts = parts
            renderData[plr] = rd
            ::continue::
        end

        if Config.ESP.PriorityTarget then
            local bestScore = -math.huge
            local bestPlr
            local maxDist = Config.ESP.MaxDistance
            local halfW = Camera.ViewportSize.X / 2
            for plr, rd in pairs(renderData) do
                if rd and rd.onScreen and not (Config.ESP.HideTeammates and isTeammate(plr)) then
                    local normDist = rd.distance / maxDist
                    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    local distToCenter = (rd.hrpPos - center).Magnitude
                    local normPixels = distToCenter / halfW
                    local score = (rd.visible and 1 or 0) - normDist - normPixels * 0.5
                    if score > bestScore then
                        bestScore = score
                        bestPlr = plr
                    end
                end
            end
            for plr, rd in pairs(renderData) do
                if rd then
                    rd.priority = (plr == bestPlr)
                end
            end
        end

        for plr, rd in pairs(renderData) do
            local d = playersData[plr]
            if d and rd then
                updateBoxPosition(d, rd.parts, rd)
            end
        end
    end

    if skeleton then
        lastSkeletonUpdate = now
        for plr, rd in pairs(renderData) do
            local d = playersData[plr]
            if d and rd then
                updateSkeletonOptimized(d, rd.parts, rd)
            end
        end
    end

    if text then
        lastTextUpdate = now
        for plr, rd in pairs(renderData) do
            local d = playersData[plr]
            if d and rd then
                updateTextOptimized(d, rd.parts, rd)
                
                if Config.ESP.ShowTracer then
                    if not d.tracer then
                        d.tracer = getFromPool(drawingPool.tracers, "Line")
                        d.tracer.Thickness = Config.ESP.TracerThickness
                    end
                    if rd.onScreen and rd.distance <= Config.ESP.MaxDistance and rd.distance >= Config.ESP.MinDistance then
                        local sc = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        d.tracer.From = sc
                        d.tracer.To = Vector2.new(rd.hrpPos.X, rd.hrpPos.Y + 30)
                        d.tracer.Color = rd.priority and Config.ESP.PriorityColor or Config.ESP.TracerColor
                        d.tracer.Visible = true
                    else
                        d.tracer.Visible = false
                    end
                elseif d.tracer then
                    d.tracer.Visible = false
                end
            end
        end
    end

    if arrow then
        lastArrowUpdate = now
        for plr, rd in pairs(renderData) do
            local d = playersData[plr]
            if d and rd then
                updateArrowOptimized(d, rd)
            end
        end
    end
end

-- ===== RAGE (Anti-Aim) =====
local function createAntiAim(mode)
    if RageConfig.RageFeatures.Spinbot and mode == "Off" then
        mode = "Spin"
    end
    
    if mode == "Off" then
        if antiAimGyro then
            destroyAntiAim()
        end
        return
    end
    local char = LP.Character
    if not char then
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end
    if antiAimGyro and antiAimGyro.Mode == mode then
        return
    end
    if antiAimGyro then
        destroyAntiAim()
    end

    local align = Instance.new("AlignOrientation")
    align.Mode = Enum.OrientationAlignmentMode.TwoAttachment
    align.MaxTorque = 100000
    align.MaxAngularVelocity = 100
    align.Responsiveness = 100
    align.Parent = hrp

    local att0 = Instance.new("Attachment")
    att0.Parent = hrp
    local att1 = Instance.new("Attachment")
    att1.WorldCFrame = hrp.CFrame
    att1.Parent = hrp
    align.Attachment0 = att0
    align.Attachment1 = att1
    antiAimGyro = { Align = align, Att0 = att0, Att1 = att1, Mode = mode }
end

destroyAntiAim = function()
    if antiAimGyro then
        if antiAimGyro.Att0 then
            antiAimGyro.Att0:Destroy()
        end
        if antiAimGyro.Att1 then
            antiAimGyro.Att1:Destroy()
        end
        if antiAimGyro.Align then
            antiAimGyro.Align:Destroy()
        end
        antiAimGyro = nil
    end
end

updateAntiAim = function(dt)
    if not antiAimGyro then
        if RageActive and RageConfig.RageFeatures.Spinbot then
            createAntiAim("Spin")
        end
        return
    end
    local char = LP.Character
    if not char then
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end

    local mode = antiAimGyro.Mode
    if mode == "Spin" then
        local angSpeed = RageConfig.RageFeatures.SpinSpeed * 2 * math.pi
        local newCF = hrp.CFrame * CFrame.Angles(0, angSpeed * dt, 0)
        antiAimGyro.Att1.WorldCFrame = newCF
    elseif mode == "Jitter" then
        local angleX = math.random(-20, 20) / 100
        local angleY = math.random(-20, 20) / 100
        local angleZ = math.random(-20, 20) / 100
        local newCF = hrp.CFrame * CFrame.Angles(angleX, angleY, angleZ)
        antiAimGyro.Att1.WorldCFrame = newCF
    elseif mode == "StaticDown" then
        local newCF = hrp.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
        antiAimGyro.Att1.WorldCFrame = newCF
    end
end

local function switchToRageConfig()
    RageActive = true
    RageConfig.ESP = table.clone(LegitConfig.ESP)
    Config = RageConfig
    if RageConfig.RageFeatures.Enabled and RageConfig.RageMasterSwitch then
        local mode = RageConfig.RageFeatures.AntiAimMode
        if RageConfig.RageFeatures.Spinbot and mode == "Off" then
            mode = "Spin"
        end
        createAntiAim(mode)
    end
end

local function switchToLegitConfig()
    RageActive = false
    Config = LegitConfig
    destroyAntiAim()
    stopAutoFireLoop()
end

local function applyRageToggle(enabled)
    if enabled then
        switchToRageConfig()
    else
        switchToLegitConfig()
    end
end

