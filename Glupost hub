-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ESP =====
local function removeFromPool(pool, obj)
    for i,v in ipairs(pool) do
        if v == obj then
            table.remove(pool, i)
            break
        end
    end
end

local function getFromPool(pool, type)
    for i,obj in ipairs(pool) do
        if obj and obj.Visible == false then
            return obj
        end
    end
    local new = Drawing.new(type)
    table.insert(pool, new)
    return new
end

local function hideAll(d)
    if not d then return end
    if d.drawings then
        for _,g in pairs(d.drawings) do
            if type(g) == "table" then
                for _,o in pairs(g) do
                    if o then o.Visible = false end
                end
            elseif g then
                g.Visible = false
            end
        end
    end
    if d.skeletonLines then
        for _,l in pairs(d.skeletonLines) do
            if l then l.Visible = false end
        end
    end
    if d.texts then
        for _,t in pairs(d.texts) do
            if t then t.Visible = false end
        end
    end
    if d.tracer then
        d.tracer.Visible = false
    end
    if d.adornment then
        d.adornment.Visible = false
    end
    if d.arrow then
        for _,a in pairs(d.arrow) do
            if a then a.Visible = false end
        end
    end
    if d.highlight then
        d.highlight.Enabled = false
    end
end

local function destroyAll(d)
    if not d then return end
    if d.drawings then
        for _,g in pairs(d.drawings) do
            if type(g) == "table" then
                for _,o in pairs(g) do
                    safeDestroy(o)
                    removeFromPool(drawingPool.lines, o)
                    removeFromPool(drawingPool.corners, o)
                end
            else
                safeDestroy(g)
                removeFromPool(drawingPool.lines, g)
            end
        end
        d.drawings = nil
    end
    if d.skeletonLines then
        for _,l in pairs(d.skeletonLines) do
            safeDestroy(l)
            removeFromPool(drawingPool.skeleton, l)
        end
        d.skeletonLines = nil
    end
    if d.texts then
        for _,t in pairs(d.texts) do
            safeDestroy(t)
            removeFromPool(drawingPool.texts, t)
        end
        d.texts = nil
    end
    if d.tracer then
        safeDestroy(d.tracer)
        removeFromPool(drawingPool.tracers, d.tracer)
        d.tracer = nil
    end
    if d.adornment then
        safeDestroy(d.adornment)
        d.adornment = nil
    end
    if d.arrow then
        for _,a in pairs(d.arrow) do
            safeDestroy(a)
            removeFromPool(drawingPool.arrows, a)
        end
        d.arrow = nil
    end
    if d.highlight then
        safeDestroy(d.highlight)
        d.highlight = nil
    end
end

local function isTeammate(plr)
    if LP.Team and plr.Team and LP.Team == plr.Team then return true end
    local myTeam = LP:GetAttribute("Team")
    local theirTeam = plr:GetAttribute("Team")
    if myTeam and theirTeam and myTeam == theirTeam then return true end
    local myLs = LP:FindFirstChild("leaderstats")
    local theirLs = plr:FindFirstChild("leaderstats")
    if myLs and theirLs then
        local myT = myLs:FindFirstChild("Team")
        local theirT = theirLs:FindFirstChild("Team")
        if myT and theirT and myT.Value == theirT.Value then return true end
    end
    return false
end

local function setupPlayer(plr)
    if plr == LP then return end
    if playersData[plr] then hideAll(playersData[plr]) end
    if connections[plr] then
        for _,c in pairs(connections[plr]) do
            if c then c:Disconnect() end
        end
    end
    playersData[plr] = {parts={}, drawings=nil, skeletonLines=nil, texts=nil, tracer=nil, adornment=nil, arrow=nil, highlight=nil, visible=false, lastVisibleUpdate=0}
    renderData[plr] = nil
    connections[plr] = {}

    local ca = plr.CharacterAdded:Connect(function(char)
        task.spawn(function()
            if LP.Character then
                rayParams.FilterDescendantsInstances = {LP.Character, Camera}
            end
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            local head = char:WaitForChild("Head", 5)
            if hrp and head and char.Parent then
                cachePlayerParts(plr, char)
                local d = playersData[plr]
                if d then
                    if d.highlight then
                        safeDestroy(d.highlight)
                        d.highlight = nil
                    end
                    if Config.ESP.Chams then
                        local hl = Instance.new("Highlight")
                        hl.Name = "GlupostESPHighlight"
                        hl.FillColor = Config.ESP.ChamsVisibleColor
                        hl.OutlineColor = Config.ESP.ChamsOccludedColor
                        hl.FillTransparency = Config.ESP.ChamsTransparency
                        hl.Parent = char
                        d.highlight = hl
                    end
                end
            end
        end)
    end)

    local cr = plr.CharacterRemoving:Connect(function()
        if currentTarget and currentTarget.Parent then
            local targetPlr = Players:GetPlayerFromCharacter(currentTarget.Parent)
            if targetPlr == plr then
                currentTarget = nil
                lockedTarget = nil
            end
        end
        if playersData[plr] then
            if playersData[plr].highlight then
                safeDestroy(playersData[plr].highlight)
                playersData[plr].highlight = nil
            end
            hideAll(playersData[plr])
        end
        predictionCache[plr] = nil
        threatScoreCache[plr] = nil
    end)
    connections[plr].CharacterAdded = ca
    connections[plr].CharacterRemoving = cr
    if plr.Character then
        cachePlayerParts(plr, plr.Character)
    end
end

local function getBoxColor(plr, visible, priority)
    if priority then return Config.ESP.PriorityColor end
    if Config.ESP.VisibleCheck then
        return visible and Config.ESP.VisibleColor or Config.ESP.OccludedColor
    else
        if Config.ESP.HideTeammates and isTeammate(plr) then
            return Config.ESP.AllyColor
        else
            return Config.ESP.EnemyColor
        end
    end
end

local function isVisibleCached(data, part)
    local now = os.clock()
    if now - data.lastVisibleUpdate < CONST.VISIBLE_UPDATE_INTERVAL then
        return data.visible
    end
    data.lastVisibleUpdate = now
    if not part then
        data.visible = false
        return false
    end
    local origin = cachedCameraPosition
    local delta = part.Position - origin
    local mag = delta.Magnitude
    if mag < 0.001 then
        data.visible = true
        return true
    end
    local dir = delta / mag
    if LP.Character then
        table.clear(visibleCheckExclude)
        table.insert(visibleCheckExclude, Camera)
        table.insert(visibleCheckExclude, LP.Character)
    end
    rayParams.FilterDescendantsInstances = visibleCheckExclude
    local res = workspace:Raycast(origin, dir * mag, rayParams)
    if not res then
        data.visible = true
        return true
    end
    data.visible = (res.Position - origin).Magnitude >= mag - 0.5
    return data.visible
end

