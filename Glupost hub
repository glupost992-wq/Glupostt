-- ===== ФУНКЦИЯ ДЛЯ HUMANIZE =====
local function getHumanizedFactor(dt)
    local osc = Config.Aimbot.HumanizeOscillation or 2.5
    local freq = Config.Aimbot.HumanizeFrequency or 1.2
    local amplitude = 0.7 + 0.3 * math.sin(os.clock() * freq + math.random() * 0.1)
    amplitude = amplitude * (1 + (osc - 2.5) * 0.05)
    return math.clamp(Config.Aimbot.Smoothness * dt * 60 * amplitude, 0.05, 0.8)
end

