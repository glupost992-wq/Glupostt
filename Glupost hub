updateFrameTimeProfiler = function()
    if not Config.ESP.ShowFPS then
        return
    end
    local now = os.clock()
    local frameTime = now - lastFrameTime
    table.insert(frameDurations, frameTime)
    if #frameDurations > CONST.FPS_SAMPLE_COUNT then
        table.remove(frameDurations, 1)
    end
    local avgTime = 0
    for _, v in ipairs(frameDurations) do
        avgTime = avgTime + v
    end
    avgTime = avgTime / #frameDurations
    lastFrameTime = now
    if frameTimeLabel then
        frameTimeLabel.Text = string.format("Frame: %.2f ms", avgTime * 1000)
        frameTimeLabel.Visible = true
    end
end

local function createFPSDisplay()
    if fpsLabel then
        return
    end
    local gui = Instance.new("ScreenGui")
    gui.Name = "FPSDisplay"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")

    fpsLabel = Instance.new("TextLabel", gui)
    fpsLabel.Size = UDim2.new(0, 100, 0, 20)
    fpsLabel.Position = UDim2.new(1, -110, 0, 10)
    fpsLabel.BackgroundTransparency = 1
    fpsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    fpsLabel.TextStrokeTransparency = 0.5
    fpsLabel.Font = Enum.Font.SourceSansBold
    fpsLabel.TextSize = 12

    drawCountLabel = Instance.new("TextLabel", gui)
    drawCountLabel.Size = UDim2.new(0, 100, 0, 20)
    drawCountLabel.Position = UDim2.new(1, -110, 0, 30)
    drawCountLabel.BackgroundTransparency = 1
    drawCountLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    drawCountLabel.Font = Enum.Font.SourceSans
    drawCountLabel.TextSize = 10

    frameTimeLabel = Instance.new("TextLabel", gui)
    frameTimeLabel.Size = UDim2.new(0, 100, 0, 20)
    frameTimeLabel.Position = UDim2.new(1, -110, 0, 50)
    frameTimeLabel.BackgroundTransparency = 1
    frameTimeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    frameTimeLabel.Font = Enum.Font.SourceSans
    frameTimeLabel.TextSize = 10
end

local function updateFPSDisplay(dt)
    if dt <= 0 then return end
    
    if not Config.ESP.ShowFPS then
        if fpsLabel then
            fpsLabel.Visible = false
        end
        if drawCountLabel then
            drawCountLabel.Visible = false
        end
        if frameTimeLabel then
            frameTimeLabel.Visible = false
        end
        return
    end
    if not fpsLabel then
        createFPSDisplay()
    end
    fpsLabel.Visible = true
    drawCountLabel.Visible = true
    if frameTimeLabel then
        frameTimeLabel.Visible = true
    end

    local inst = 1 / dt
    fpsSum = fpsSum + inst
    fpsCount = fpsCount + 1
    if fpsCount >= CONST.FPS_SAMPLE_COUNT then
        currentFPS = fpsSum / fpsCount
        fpsSum = 0
        fpsCount = 0
    end

    if os.clock() - lastDrawCountUpdate > CONST.DRAW_COUNT_UPDATE_INTERVAL then
        drawCountValue = 0
        for _, p in pairs(drawingPool) do
            drawCountValue = drawCountValue + #p
        end
        lastDrawCountUpdate = os.clock()
    end

    drawCountLabel.Text = string.format("Draw: %d", drawCountValue)
    fpsLabel.Text = string.format("FPS: %.1f", currentFPS)
    if updateFrameTimeProfiler then
        updateFrameTimeProfiler()
    end
end

